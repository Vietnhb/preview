{
  "schemaId": "light_interference",
  "model": "light_interference",
  "name": "Two-source light interference",
  "topic": "OPTICS",
  "version": "1.2",
  "solverId": "light_interference_solver_v2",
  "referenceSolverId": "light_interference_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "wavelength",
        "aliases": ["lambda", "λ"],
        "symbols": ["λ"],
        "allowedUnits": ["m"],
        "positive": true
      },
      {
        "key": "path_difference",
        "aliases": ["delta", "Δ", "δ"],
        "symbols": ["Δ", "δ"],
        "allowedUnits": ["m"]
      },
      {
        "key": "reference_intensity",
        "aliases": ["I0", "I₀"],
        "symbols": ["I₀"],
        "allowedUnits": ["W/m2"],
        "nonNegative": true
      }
    ],
    "optionalQuantities": [
      {
        "key": "path_difference_rate",
        "aliases": ["delta_rate", "dDelta_dt"],
        "symbols": ["dΔ/dt"],
        "allowedUnits": ["m/s"],
        "defaultValue": 0,
        "defaultUnit": "m/s"
      }
    ],
    "adjustableParameters": [
      {
        "key": "path_difference",
        "label": "Path difference",
        "symbol": "Δ",
        "unit": "m",
        "min": -1,
        "max": 1,
        "step": 0.0001
      }
    ],
    "visualization": {
      "scene": "light_interference",
      "series": [
        {
          "key": "phaseDifference",
          "source": "values.phaseDifference",
          "label": "Phase difference",
          "symbol": "φ",
          "unit": "rad",
          "color": "#a78bfa"
        },
        {
          "key": "intensity",
          "source": "values.intensity",
          "label": "Intensity",
          "symbol": "I",
          "unit": "W/m2",
          "color": "#38bdf8"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "optical.bench",
        "sceneGraph": {
          "nodes": [
            {"id": "background", "type": "background", "layer": "static"},
            {"id": "graph", "type": "graph", "layer": "dynamic", "properties": {"source": "values.intensity"}}
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 0.000001,
      "checkpointFractions": [0.25, 0.5, 0.75, 1]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": ["phaseDifference", "intensity"]
    }
  }
}
