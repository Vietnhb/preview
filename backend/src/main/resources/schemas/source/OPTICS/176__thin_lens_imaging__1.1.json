{
  "schemaId": "thin_lens_imaging",
  "model": "thin_lens_imaging",
  "name": "Paraxial thin-lens imaging",
  "topic": "OPTICS",
  "version": "1.1",
  "solverId": "thin_lens_solver",
  "referenceSolverId": "thin_lens_reference",
  "definition": {
    "requiredQuantities": [
      {
        "key": "focal_length",
        "aliases": [
          "f"
        ],
        "allowedUnits": [
          "m"
        ]
      },
      {
        "key": "object_distance",
        "aliases": [
          "d_o",
          "do"
        ],
        "allowedUnits": [
          "m"
        ],
        "positive": true
      },
      {
        "key": "object_height",
        "aliases": [
          "h_o",
          "ho"
        ],
        "allowedUnits": [
          "m"
        ]
      }
    ],
    "adjustableParameters": [
      {
        "key": "focal_length",
        "label": "Focal length",
        "symbol": "f",
        "unit": "m",
        "min": -10,
        "max": 10,
        "step": 0.001
      },
      {
        "key": "object_distance",
        "label": "Object distance",
        "symbol": "d_o",
        "unit": "m",
        "min": 0.001,
        "max": 100,
        "step": 0.001
      },
      {
        "key": "object_height",
        "label": "Object height",
        "symbol": "h_o",
        "unit": "m",
        "min": -10,
        "max": 10,
        "step": 0.001
      }
    ],
    "visualization": {
      "scene": "thin_lens_imaging",
      "series": [
        {
          "key": "imageDistance",
          "source": "values.imageDistance",
          "label": "Image distance",
          "symbol": "d_i",
          "unit": "m",
          "color": "#38bdf8"
        },
        {
          "key": "imageHeight",
          "source": "values.imageHeight",
          "label": "Image height",
          "symbol": "h_i",
          "unit": "m",
          "color": "#34d399"
        },
        {
          "key": "magnification",
          "source": "values.magnification",
          "label": "Magnification",
          "symbol": "M",
          "unit": "1",
          "color": "#fb923c"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "optical.bench",
        "sceneGraph": {
          "nodes": [
            {
              "id": "background",
              "type": "background",
              "layer": "static"
            },
            {
              "id": "grid",
              "type": "grid",
              "layer": "static"
            },
            {
              "id": "environment",
              "type": "environment",
              "layer": "static",
              "properties": {
                "environment": "optical.bench",
                "layout": "horizontalTrack"
              }
            },
            {
              "id": "axis",
              "type": "line",
              "layer": "static",
              "transform": {
                "x": 0,
                "y": 0
              },
              "properties": {
                "dx": 1,
                "dy": 0,
                "label": "optical axis"
              }
            },
            {
              "id": "imageGraph",
              "type": "graph",
              "layer": "dynamic",
              "properties": {
                "source": "values.imageDistance"
              }
            },
            {
              "id": "ruler",
              "type": "ruler",
              "layer": "static"
            }
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 1e-06,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1.0
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "imageDistance",
        "imageHeight",
        "magnification"
      ],
      "definitions": [
        {
          "key": "imageDistance",
          "kind": "time_series",
          "unit": "m",
          "required": true
        },
        {
          "key": "imageHeight",
          "kind": "time_series",
          "unit": "m",
          "required": true
        },
        {
          "key": "magnification",
          "kind": "time_series",
          "unit": "1",
          "required": true
        }
      ]
    }
  }
}
