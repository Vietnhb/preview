{
  "schemaId": "ideal_gas_isobaric",
  "model": "ideal_gas_isobaric",
  "name": "Isobaric ideal-gas process",
  "topic": "THERMAL",
  "version": "1.1",
  "solverId": "ideal_gas_isobaric_solver_v2",
  "referenceSolverId": "ideal_gas_isobaric_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "initial_pressure",
        "aliases": [
          "P1"
        ],
        "allowedUnits": [
          "Pa"
        ],
        "positive": true
      },
      {
        "key": "initial_volume",
        "aliases": [
          "V1"
        ],
        "allowedUnits": [
          "m3"
        ],
        "positive": true
      },
      {
        "key": "initial_temperature",
        "aliases": [
          "T1"
        ],
        "allowedUnits": [
          "K"
        ],
        "positive": true
      },
      {
        "key": "final_temperature",
        "aliases": [
          "T2"
        ],
        "allowedUnits": [
          "K"
        ],
        "positive": true
      }
    ],
    "adjustableParameters": [
      {
        "key": "final_temperature",
        "label": "Final temperature",
        "symbol": "T2",
        "unit": "K",
        "min": 1,
        "max": 5000,
        "step": 1
      }
    ],
    "visualization": {
      "scene": "ideal_gas_isobaric",
      "series": [
        {
          "key": "finalVolume",
          "source": "values.finalVolume",
          "label": "Final volume",
          "symbol": "V2",
          "unit": "m3",
          "color": "#38bdf8"
        },
        {
          "key": "work",
          "source": "values.work",
          "label": "Work",
          "symbol": "W",
          "unit": "J",
          "color": "#fb923c"
        }
      ]
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 0.000001,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "finalPressure",
        "finalVolume",
        "work"
      ]
    }
  }
}
