{
  "schemaId": "temperature_scales",
  "model": "temperature_scales",
  "name": "Temperature scales",
  "topic": "THERMAL",
  "version": "1.1",
  "solverId": "temperature_scale_solver",
  "referenceSolverId": "temperature_scale_reference",
  "definition": {
    "requiredQuantities": [
      {
        "key": "temperature_celsius",
        "aliases": [
          "celsius",
          "°C"
        ],
        "allowedUnits": [
          "degC"
        ]
      }
    ],
    "adjustableParameters": [
      {
        "key": "temperature_celsius",
        "label": "Celsius value",
        "symbol": "°C",
        "unit": "degC",
        "min": -273.15,
        "max": 5000,
        "step": 1
      }
    ],
    "visualization": {
      "scene": "temperature_scales",
      "series": [
        {
          "key": "kelvin",
          "source": "values.kelvin",
          "label": "Kelvin",
          "symbol": "T",
          "unit": "K",
          "color": "#38bdf8"
        },
        {
          "key": "fahrenheit",
          "source": "values.fahrenheit",
          "label": "Fahrenheit",
          "symbol": "°F",
          "unit": "1",
          "color": "#fb923c"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "room.thermodynamics",
        "sceneGraph": {
          "nodes": [
            {
              "id": "background",
              "type": "background",
              "layer": "static"
            },
            {
              "id": "graph",
              "type": "graph",
              "layer": "dynamic",
              "properties": {
                "source": "values.kelvin"
              }
            }
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 0.000001,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "celsius",
        "kelvin",
        "fahrenheit"
      ]
    }
  }
}
