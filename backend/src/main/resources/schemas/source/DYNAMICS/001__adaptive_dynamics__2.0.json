    "laws": [
      {
        "id": "newton_second",
        "name": "Định luật II Newton",
        "inputs": [
          "force",
          "mass"
        ],
        "outputs": [
          "acceleration"
        ],
        "appliesTo": {
          "objectTypes": [
            "body"
          ],
          "quantities": [
            "force",
            "mass",
            "acceleration"
          ]
        },
        "assumptions": [
          "Inertial frame or justified approximation.",
          "Relevant forces and directions identified."
        ],
        "description": "Acceleration follows the net force."
      },
      {
        "id": "hooke",
        "name": "Định luật Hooke",
        "inputs": [
          "spring_constant",
          "extension"
        ],
        "outputs": [
          "force"
        ],
        "appliesTo": {
          "objectTypes": [
            "spring",
            "body"
          ],
          "quantities": [
            "spring_constant",
            "extension",
            "force"
          ]
        },
        "assumptions": [
          "Spring remains in linear elastic range."
        ],
        "description": "Restoring force is proportional to extension."
      },
      {
        "id": "linear_drag",
        "name": "Lực cản tuyến tính",
        "inputs": [
          "damping_coefficient",
          "velocity"
