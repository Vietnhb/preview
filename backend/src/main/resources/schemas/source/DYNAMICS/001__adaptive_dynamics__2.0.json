            "body",
            "fluid"
          ],
          "quantities": [
            "damping_coefficient",
            "velocity",
            "force"
          ]
        },
        "assumptions": [
          "Linear drag model stated or accepted."
        ],
        "description": "Drag opposes velocity."
      },
      {
        "id": "buoyancy",
        "name": "Lực đẩy Archimedes",
        "inputs": [
          "fluid_density",
          "gravitational_acceleration",
          "displaced_volume"
        ],
        "outputs": [
          "force"
        ],
        "appliesTo": {
          "objectTypes": [
            "body",
            "fluid"
          ],
          "quantities": [
            "fluid_density",
            "gravitational_acceleration",
            "displaced_volume",
            "force"
          ]
        },
        "assumptions": [
          "Static fluid and displaced volume known."
        ],
        "description": "Buoyant force magnitude."
      }
    ],
    "capabilities": [
      {
        "capabilityId": "fixed_length_gravity_oscillation",
        "version": "1.0",
        "applicability": {
          "objectTypes": ["body"],
          "quantities": ["length", "initial_angle", "initial_angular_velocity", "gravitational_acceleration"]
        },
        "canonicalInputs": [
          {"key": "length", "unit": "m"},
          {"key": "initial_angle", "unit": "rad"},
          {"key": "initial_angular_velocity", "unit": "rad/s", "defaultValue": 0},
          {"key": "gravitational_acceleration", "unit": "m/s^2", "defaultValue": 9.80665}
        ],
        "outputs": [
          {"key": "angle", "unit": "rad"},
          {"key": "angular_velocity", "unit": "rad/s"},
          {"key": "x", "unit": "m"},
          {"key": "y", "unit": "m"},
          {"key": "vx", "unit": "m/s"},
          {"key": "vy", "unit": "m/s"}
        ],
        "assumptions": [
          "The connector length is fixed and massless.",
          "The pivot is fixed, gravity is uniform, and damping or driving is absent unless composed with another capability."
        ],
        "validityDomain": {"lengthPositive": true, "gravityPositive": true, "durationPositive": true},
        "equationSet": {
          "canonical": ["d2theta/dt2=-(g/L)*sin(theta)"],
          "derived": ["x=L*sin(theta)", "y=-L*cos(theta)"],
          "dependencies": []
        },
        "execution": {
          "primary": "numerical",
          "numerical": {"solverId": "pendulum_dynamics_rk4_v1", "method": "rk4_with_bounded_substeps", "stepSeconds": 0.02},
          "closedForm": null
        },
        "validation": {
          "strategy": "residual_invariants",
          "absoluteTolerance": 0.0001,
          "relativeTolerance": 0.0001,
          "invariants": ["finite_output", "mechanical_energy_conservation"],
          "benchmarks": [
            {"name": "stationary_equilibrium", "inputs": {"initial_angle": 0, "initial_angular_velocity": 0}}
          ]
        },
        "rendererBindings": [
          {"source": "positions.x", "role": "horizontal_position"},
          {"source": "positions.y", "role": "vertical_position"},
          {"source": "velocities", "role": "velocity_vector"},
          {"source": "values.angle", "role": "angle_annotation"}
        ]
      }
    ],
