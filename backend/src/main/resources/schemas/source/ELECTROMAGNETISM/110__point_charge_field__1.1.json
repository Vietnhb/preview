{
  "schemaId": "point_charge_field",
  "model": "point_charge_field",
  "name": "Point-charge electric field and potential",
  "description": "Electric field magnitude and electric potential at a radial probe from an isolated point charge.",
  "topic": "ELECTROMAGNETISM",
  "version": "1.1",
  "solverId": "point_charge_field_solver_v2",
  "referenceSolverId": "point_charge_field_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "charge",
        "aliases": ["q"],
        "allowedUnits": ["C"]
      },
      {
        "key": "distance",
        "aliases": ["r"],
        "allowedUnits": ["m"],
        "positive": true
      }
    ],
    "adjustableParameters": [
      {
        "key": "distance",
        "label": "Probe distance",
        "symbol": "r",
        "unit": "m",
        "min": 0.001,
        "max": 100,
        "step": 0.001
      }
    ],
    "visualization": {
      "scene": "point_charge_field",
      "series": [
        {
          "key": "electricField",
          "source": "scalarOutputs.electricField",
          "label": "Electric field magnitude",
          "symbol": "E",
          "unit": "N/C",
          "color": "#38bdf8"
        },
        {
          "key": "electricPotential",
          "source": "scalarOutputs.electricPotential",
          "label": "Electric potential",
          "symbol": "V",
          "unit": "V",
          "color": "#fb923c"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "board.circuit",
        "sceneGraph": {
          "nodes": [
            {
              "id": "background",
              "type": "background",
              "layer": "static"
            },
            {
              "id": "environment",
              "type": "environment",
              "layer": "static",
              "properties": {
                "environment": "board.circuit"
              }
            },
            {
              "id": "graph",
              "type": "graph",
              "layer": "dynamic",
              "properties": {
                "source": "scalarOutputs.electricField"
              }
            }
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 0.000001,
      "checkpointFractions": [0.25, 0.5, 0.75, 1]
    },
    "output": {
      "definitions": [
        { "key": "electricField", "kind": "scalar", "unit": "N/C", "required": true },
        { "key": "electricPotential", "kind": "scalar", "unit": "V", "required": true }
      ]
    }
  }
}
