{
  "schemaId": "measurement_uncertainty",
  "model": "measurement_uncertainty",
  "name": "Measurement uncertainty",
  "topic": "PRACTICAL_AND_DATA",
  "version": "1.3",
  "solverId": "measurement_uncertainty_solver_v2",
  "referenceSolverId": "measurement_uncertainty_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "measured_value",
        "aliases": [
          "x"
        ],
        "allowedUnits": [
          "1"
        ]
      },
      {
        "key": "absolute_uncertainty",
        "aliases": [
          "delta_x",
          "uncertainty"
        ],
        "allowedUnits": [
          "1"
        ],
        "nonNegative": true,
        "sameUnitAs": "measured_value"
      }
    ],
    "adjustableParameters": [
      {
        "key": "measured_value",
        "label": "Measured value",
        "symbol": "x",
        "unit": "1",
        "min": -1000000,
        "max": 1000000,
        "step": 0.01
      },
      {
        "key": "absolute_uncertainty",
        "label": "Absolute uncertainty",
        "symbol": "Δx",
        "unit": "1",
        "min": 0,
        "max": 1000000,
        "step": 0.01
      }
    ],
    "visualization": {
      "scene": "measurement_uncertainty",
      "series": [
        {
          "key": "measuredValue",
          "source": "values.measuredValue",
          "label": "Measured value",
          "symbol": "x",
          "unit": "1",
          "color": "#38bdf8"
        },
        {
          "key": "lowerBound",
          "source": "values.lowerBound",
          "label": "Lower bound",
          "symbol": "x-Δx",
          "unit": "1",
          "color": "#fb923c"
        },
        {
          "key": "upperBound",
          "source": "values.upperBound",
          "label": "Upper bound",
          "symbol": "x+Δx",
          "unit": "1",
          "color": "#34d399"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "lab.measurement",
        "sceneGraph": {
          "nodes": [
            {
              "id": "background",
              "type": "background",
              "layer": "static"
            },
            {
              "id": "grid",
              "type": "grid",
              "layer": "static"
            },
            {
              "id": "graph",
              "type": "graph",
              "layer": "dynamic",
              "properties": {
                "source": "values.measuredValue"
              }
            }
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 1e-06,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "measuredValue",
        "absoluteUncertainty",
        "relativeUncertainty",
        "relativeUncertaintyDefined",
        "lowerBound",
        "upperBound"
      ],
      "definitions": [
        {
          "key": "measuredValue",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "absoluteUncertainty",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "relativeUncertainty",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "relativeUncertaintyDefined",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "lowerBound",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "upperBound",
          "kind": "time_series",
          "unit": "1",
          "required": true
        }
      ]
    }
  }
}
