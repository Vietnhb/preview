{
  "schemaId": "experimental_data_graph",
  "model": "experimental_data_graph",
  "name": "Experimental data graph",
  "topic": "PRACTICAL_AND_DATA",
  "version": "1.1",
  "solverId": "experimental_data_graph_solver_v2",
  "referenceSolverId": "experimental_data_graph_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "x_start",
        "aliases": [
          "x0"
        ],
        "allowedUnits": [
          "1"
        ]
      },
      {
        "key": "x_end",
        "aliases": [
          "x1"
        ],
        "allowedUnits": [
          "1"
        ]
      },
      {
        "key": "slope",
        "aliases": [
          "m"
        ],
        "allowedUnits": [
          "1"
        ]
      },
      {
        "key": "intercept",
        "aliases": [
          "b"
        ],
        "allowedUnits": [
          "1"
        ]
      }
    ],
    "optionalQuantities": [
      {
        "key": "sample_count",
        "aliases": [
          "N"
        ],
        "allowedUnits": [
          "1"
        ],
        "integer": true,
        "defaultValue": 25,
        "min": 2,
        "max": 4096
      }
    ],
    "adjustableParameters": [
      {
        "key": "slope",
        "label": "Fitted slope",
        "symbol": "m",
        "unit": "1",
        "min": -1000,
        "max": 1000,
        "step": 0.01
      }
    ],
    "visualization": {
      "scene": "experimental_data_graph",
      "series": [
        {
          "key": "measuredData",
          "source": "values.y",
          "label": "Experimental data",
          "symbol": "y(x)",
          "unit": "1",
          "color": "#38bdf8"
        },
        {
          "key": "fitSlope",
          "source": "values.slope",
          "label": "Linear fit slope",
          "symbol": "m",
          "unit": "1",
          "color": "#fb923c"
        }
      ]
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 1e-06,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "x",
        "y",
        "slope",
        "intercept"
      ],
      "definitions": [
        {
          "key": "x",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "y",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "slope",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "intercept",
          "kind": "time_series",
          "unit": "1",
          "required": true
        }
      ]
    }
  }
}
