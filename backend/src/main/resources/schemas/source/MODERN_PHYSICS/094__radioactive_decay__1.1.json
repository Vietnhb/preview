{
  "schemaId": "radioactive_decay",
  "model": "radioactive_decay",
  "name": "Radioactive exponential decay",
  "topic": "MODERN_PHYSICS",
  "version": "1.1",
  "solverId": "radioactive_decay_solver_v2",
  "referenceSolverId": "radioactive_decay_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "initial_count",
        "aliases": [
          "N0",
          "atoms"
        ],
        "allowedUnits": [
          "1"
        ],
        "nonNegative": true
      },
      {
        "key": "decay_constant",
        "aliases": [
          "lambda",
          "lambda_decay"
        ],
        "allowedUnits": [
          "1/s"
        ],
        "nonNegative": true
      }
    ],
    "adjustableParameters": [
      {
        "key": "initial_count",
        "label": "Initial nuclei",
        "symbol": "N0",
        "unit": "1",
        "min": 0,
        "max": 1000000000,
        "step": 1
      },
      {
        "key": "decay_constant",
        "label": "Decay constant",
        "symbol": "lambda",
        "unit": "1/s",
        "min": 0,
        "max": 100,
        "step": 0.000001
      }
    ],
    "visualization": {
      "scene": "radioactive_decay",
      "series": [
        {
          "key": "remainingCount",
          "source": "values.remainingCount",
          "label": "Remaining nuclei",
          "symbol": "N",
          "unit": "1",
          "color": "#38bdf8"
        },
        {
          "key": "activity",
          "source": "values.activity",
          "label": "Activity",
          "symbol": "A",
          "unit": "Bq",
          "color": "#fb923c"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "lab.radiation",
        "sceneGraph": {
          "nodes": [
            {
              "id": "background",
              "type": "background",
              "layer": "static"
            },
            {
              "id": "grid",
              "type": "grid",
              "layer": "static"
            },
            {
              "id": "environment",
              "type": "environment",
              "layer": "static",
              "properties": {
                "environment": "lab.radiation",
                "layout": "horizontalTrack"
              }
            },
            {
              "id": "countGraph",
              "type": "graph",
              "layer": "dynamic",
              "properties": {
                "source": "values.remainingCount"
              }
            },
            {
              "id": "ruler",
              "type": "ruler",
              "layer": "static"
            }
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 10,
      "stepSeconds": 0.05,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 0.000001,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "remainingCount",
        "activity"
      ]
    }
  }
}
