{
  "schemaId": "water_surface_interference",
  "model": "water_surface_interference",
  "name": "Two-source water-surface interference",
  "topic": "WAVES",
  "version": "1.1",
  "solverId": "water_surface_interference_solver_v2",
  "referenceSolverId": "water_surface_interference_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "wavelength",
        "aliases": ["lambda"],
        "allowedUnits": ["m"],
        "positive": true
      },
      {
        "key": "wave_speed",
        "aliases": ["v"],
        "allowedUnits": ["m/s"],
        "positive": true
      },
      {
        "key": "source_separation",
        "aliases": ["d"],
        "allowedUnits": ["m"],
        "positive": true
      },
      {
        "key": "amplitude",
        "aliases": ["A"],
        "allowedUnits": ["m"],
        "nonNegative": true,
        "min": 0
      },
      {
        "key": "domain_size",
        "aliases": ["L"],
        "allowedUnits": ["m"],
        "positive": true
      },
      {
        "key": "spatial_samples",
        "aliases": ["N"],
        "allowedUnits": ["1"],
        "positive": true,
        "integer": true,
        "min": 8,
        "max": 128
      }
    ],
    "adjustableParameters": [
      {
        "key": "source_separation",
        "label": "Source separation",
        "symbol": "d",
        "unit": "m",
        "min": 0.0001,
        "max": 10,
        "step": 0.0001
      }
    ],
    "visualization": {
      "scene": "water_surface_interference",
      "series": [
        {
          "key": "surface",
          "source": "scalarFields.waterSurface",
          "label": "Water-surface displacement",
          "symbol": "u(x,y,t)",
          "unit": "m",
          "color": "#38bdf8"
        }
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "wave.tank",
        "wave": {
          "fieldId": "waterSurface",
          "displayExaggeration": 1
        },
        "sceneGraph": {
          "nodes": [
            {"id": "background", "type": "background", "layer": "static"},
            {
              "id": "waveField",
              "type": "waveField",
              "layer": "dynamic",
              "properties": {"field": "waterSurface"}
            }
          ]
        }
      }
    },
    "execution": {
      "durationSeconds": 2,
      "stepSeconds": 0.05,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 0.000001,
      "checkpointFractions": [0.25, 0.5, 0.75, 1]
    },
    "output": {
      "type": "scalarField",
      "probeSeries": ["centerHeight"],
      "definitions": [
        {"key": "centerHeight", "kind": "time_series", "unit": "m", "required": true},
        {"key": "waterSurface", "kind": "scalar_field", "unit": "m", "required": true}
      ]
    }
  }
}
