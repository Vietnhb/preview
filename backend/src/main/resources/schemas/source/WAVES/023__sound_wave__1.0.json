{
    "schemaId": "sound_wave",
    "model": "sound_wave",
    "name": "Acoustic pressure wave",
    "topic": "WAVES",
    "version": "1.0",
    "solverId": "sound_wave_solver",
    "referenceSolverId": "sound_wave_reference",
    "definition": {
      "requiredQuantities": [
        { "key": "pressure_amplitude", "aliases": ["p0", "pressure"], "allowedUnits": ["Pa"], "nonNegative": true },
        { "key": "frequency", "aliases": ["f"], "allowedUnits": ["Hz"], "positive": true },
        { "key": "sound_speed", "aliases": ["speed", "c"], "allowedUnits": ["m/s"], "positive": true }
      ],
      "optionalQuantities": [
        { "key": "phase", "aliases": ["phi"], "allowedUnits": ["rad"] },
        { "key": "domain_start", "aliases": ["x_min"], "allowedUnits": ["m"] },
        { "key": "domain_end", "aliases": ["x_max"], "allowedUnits": ["m"], "positive": true },
        { "key": "domain_length", "aliases": ["length"], "allowedUnits": ["m"], "positive": true },
        { "key": "probe_position", "aliases": ["x_probe"], "allowedUnits": ["m"] },
        { "key": "spatial_samples", "aliases": ["x_samples"], "allowedUnits": ["1"], "positive": true }
      ],
      "adjustableParameters": [
        { "key": "pressure_amplitude", "label": "Pressure amplitude", "symbol": "P0", "unit": "Pa", "min": 0, "max": 1000, "step": 0.1 },
        { "key": "frequency", "label": "Frequency", "symbol": "f", "unit": "Hz", "min": 1, "max": 20000, "step": 1 },
        { "key": "sound_speed", "label": "Sound speed", "symbol": "c", "unit": "m/s", "min": 1, "max": 1000, "step": 1 }
      ],
      "visualization": {
        "scene": "sound_wave",
        "series": [
          { "key": "pressure", "source": "values.pressure", "label": "Pressure at probe", "symbol": "p", "unit": "Pa", "color": "#38bdf8" },
          { "key": "pressureRate", "source": "values.pressureRate", "label": "Pressure rate", "symbol": "p_dot", "unit": "Pa/s", "color": "#34d399" },
          { "key": "pressureAcceleration", "source": "values.pressureAcceleration", "label": "Pressure acceleration", "symbol": "p_ddot", "unit": "Pa/s2", "color": "#fb923c" }
        ],
        "presentation": {
          "theme": "lab-night",
          "environment": "room.acoustics",
          "wave": { "fieldId": "soundPressure", "probeX": 0, "displayExaggeration": 1 },
          "sceneGraph": { "nodes": [
            { "id": "background", "type": "background", "layer": "static" },
            { "id": "grid", "type": "grid", "layer": "static" },
            { "id": "environment", "type": "environment", "layer": "static", "properties": { "environment": "room.acoustics", "layout": "horizontalTrack" } },
            { "id": "wave", "type": "waveField", "layer": "dynamic", "properties": { "field": "soundPressure", "probeX": 0, "displayExaggeration": 1 } },
            { "id": "ruler", "type": "ruler", "layer": "static" }
          ] }
        }
      },
      "execution": { "durationSeconds": 0.1, "stepSeconds": 0.0005, "durationBindings": [] },
      "validation": { "tolerance": 0.000001, "checkpointFractions": [0.25, 0.5, 0.75, 1.0] },
      "output": { "type": "scalarField", "fieldId": "soundPressure", "probeSeries": ["pressure", "pressureRate", "pressureAcceleration"] }
    }
  }
