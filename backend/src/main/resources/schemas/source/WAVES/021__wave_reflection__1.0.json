{
    "schemaId": "wave_reflection",
    "model": "wave_reflection",
    "name": "Reflection of a pulse at a boundary",
    "topic": "WAVES",
    "version": "1.0",
    "solverId": "wave_reflection_solver",
    "referenceSolverId": "wave_reflection_reference",
    "definition": {
      "requiredQuantities": [
        { "key": "amplitude", "aliases": ["a"], "allowedUnits": ["m"], "nonNegative": true },
        { "key": "wave_speed", "aliases": ["speed", "c"], "allowedUnits": ["m/s"], "positive": true },
        { "key": "pulse_width", "aliases": ["width", "sigma"], "allowedUnits": ["m"], "positive": true },
        { "key": "initial_position", "aliases": ["x0", "pulse_center"], "allowedUnits": ["m"] },
        { "key": "boundary_position", "aliases": ["boundary", "x_boundary"], "allowedUnits": ["m"], "positive": true }
      ],
      "optionalQuantities": [
        { "key": "domain_start", "aliases": ["x_min"], "allowedUnits": ["m"] },
        { "key": "probe_position", "aliases": ["x_probe"], "allowedUnits": ["m"] },
        { "key": "spatial_samples", "aliases": ["x_samples"], "allowedUnits": ["1"], "positive": true }
      ],
      "adjustableParameters": [
        { "key": "amplitude", "label": "Pulse amplitude", "symbol": "A", "unit": "m", "min": 0, "max": 1, "step": 0.001 },
        { "key": "wave_speed", "label": "Wave speed", "symbol": "c", "unit": "m/s", "min": 0.01, "max": 100, "step": 0.01 },
        { "key": "boundary_position", "label": "Boundary position", "symbol": "L", "unit": "m", "min": 0.1, "max": 100, "step": 0.1 }
      ],
      "visualization": {
        "scene": "wave_reflection",
        "series": [
          { "key": "displacement", "source": "values.displacement", "label": "Displacement at probe", "symbol": "u", "unit": "m", "color": "#38bdf8" },
          { "key": "particleVelocity", "source": "values.particleVelocity", "label": "Particle velocity", "symbol": "u_dot", "unit": "m/s", "color": "#34d399" },
          { "key": "particleAcceleration", "source": "values.particleAcceleration", "label": "Particle acceleration", "symbol": "u_ddot", "unit": "m/s2", "color": "#fb923c" }
        ],
        "presentation": {
          "theme": "lab-night",
          "environment": "track.engineering",
          "wave": { "fieldId": "reflectionDisplacement", "probeX": 1, "displayExaggeration": 1 },
          "sceneGraph": { "nodes": [
            { "id": "background", "type": "background", "layer": "static" },
            { "id": "grid", "type": "grid", "layer": "static" },
            { "id": "environment", "type": "environment", "layer": "static", "properties": { "environment": "track.engineering", "layout": "horizontalTrack" } },
            { "id": "wave", "type": "waveField", "layer": "dynamic", "properties": { "field": "reflectionDisplacement", "probeX": 1, "displayExaggeration": 1 } },
            { "id": "boundary", "type": "ruler", "layer": "static" }
          ] }
        }
      },
      "execution": { "durationSeconds": 10, "stepSeconds": 0.05, "durationBindings": [] },
      "validation": { "tolerance": 0.000001, "checkpointFractions": [0.25, 0.5, 0.75, 1.0] },
      "output": { "type": "scalarField", "fieldId": "reflectionDisplacement", "probeSeries": ["displacement", "particleVelocity", "particleAcceleration"] }
    }
  }
