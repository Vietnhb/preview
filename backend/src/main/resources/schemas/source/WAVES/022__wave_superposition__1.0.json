{
    "schemaId": "wave_superposition",
    "model": "wave_superposition",
    "name": "Superposition of two coherent waves",
    "topic": "WAVES",
    "version": "1.0",
    "solverId": "wave_superposition_solver",
    "referenceSolverId": "wave_superposition_reference",
    "definition": {
      "requiredQuantities": [
        { "key": "amplitude_1", "aliases": ["a1"], "allowedUnits": ["m"], "nonNegative": true },
        { "key": "amplitude_2", "aliases": ["a2"], "allowedUnits": ["m"], "nonNegative": true },
        { "key": "frequency", "aliases": ["f"], "allowedUnits": ["Hz"], "positive": true },
        { "key": "wave_speed", "aliases": ["speed", "c"], "allowedUnits": ["m/s"], "positive": true }
      ],
      "optionalQuantities": [
        { "key": "phase_1", "aliases": ["phi1"], "allowedUnits": ["rad"] },
        { "key": "phase_2", "aliases": ["phi2"], "allowedUnits": ["rad"] },
        { "key": "domain_start", "aliases": ["x_min"], "allowedUnits": ["m"] },
        { "key": "domain_end", "aliases": ["x_max"], "allowedUnits": ["m"], "positive": true },
        { "key": "domain_length", "aliases": ["length"], "allowedUnits": ["m"], "positive": true },
        { "key": "probe_position", "aliases": ["x_probe"], "allowedUnits": ["m"] },
        { "key": "spatial_samples", "aliases": ["x_samples"], "allowedUnits": ["1"], "positive": true }
      ],
      "adjustableParameters": [
        { "key": "amplitude_1", "label": "Amplitude 1", "symbol": "A1", "unit": "m", "min": 0, "max": 1, "step": 0.001 },
        { "key": "amplitude_2", "label": "Amplitude 2", "symbol": "A2", "unit": "m", "min": 0, "max": 1, "step": 0.001 },
        { "key": "phase_1", "label": "Phase 1", "symbol": "phi1", "unit": "rad", "min": -6.2831853072, "max": 6.2831853072, "step": 0.01 },
        { "key": "phase_2", "label": "Phase 2", "symbol": "phi2", "unit": "rad", "min": -6.2831853072, "max": 6.2831853072, "step": 0.01 }
      ],
      "visualization": {
        "scene": "wave_superposition",
        "series": [
          { "key": "displacement", "source": "values.displacement", "label": "Resultant displacement", "symbol": "u", "unit": "m", "color": "#38bdf8" },
          { "key": "particleVelocity", "source": "values.particleVelocity", "label": "Particle velocity", "symbol": "u_dot", "unit": "m/s", "color": "#34d399" },
          { "key": "particleAcceleration", "source": "values.particleAcceleration", "label": "Particle acceleration", "symbol": "u_ddot", "unit": "m/s2", "color": "#fb923c" }
        ],
        "presentation": {
          "theme": "lab-night",
          "environment": "track.engineering",
          "wave": { "fieldId": "superpositionDisplacement", "probeX": 0, "displayExaggeration": 1 },
          "sceneGraph": { "nodes": [
            { "id": "background", "type": "background", "layer": "static" },
            { "id": "grid", "type": "grid", "layer": "static" },
            { "id": "environment", "type": "environment", "layer": "static", "properties": { "environment": "track.engineering", "layout": "horizontalTrack" } },
            { "id": "wave", "type": "waveField", "layer": "dynamic", "properties": { "field": "superpositionDisplacement", "probeX": 0, "displayExaggeration": 1 } },
            { "id": "ruler", "type": "ruler", "layer": "static" }
          ] }
        }
      },
      "execution": { "durationSeconds": 10, "stepSeconds": 0.05, "durationBindings": [] },
      "validation": { "tolerance": 0.000001, "checkpointFractions": [0.25, 0.5, 0.75, 1.0] },
      "output": { "type": "scalarField", "fieldId": "superpositionDisplacement", "probeSeries": ["displacement", "particleVelocity", "particleAcceleration"] }
    }
  }
