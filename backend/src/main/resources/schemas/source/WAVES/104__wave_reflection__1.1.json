{
  "schemaId": "wave_reflection",
  "model": "wave_reflection",
  "name": "Gaussian pulse reflection at a boundary",
  "topic": "WAVES",
  "version": "1.1",
  "solverId": "wave_reflection_solver_v2",
  "referenceSolverId": "wave_reflection_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "amplitude",
        "aliases": ["a"],
        "allowedUnits": ["m"],
        "nonNegative": true,
        "min": 0,
        "max": 1
      },
      {
        "key": "wave_speed",
        "aliases": ["speed", "c"],
        "allowedUnits": ["m/s"],
        "positive": true,
        "min": 0.1,
        "max": 20
      },
      {
        "key": "pulse_width",
        "aliases": ["width", "sigma"],
        "allowedUnits": ["m"],
        "positive": true,
        "min": 0.1,
        "max": 5
      },
      {
        "key": "initial_position",
        "aliases": ["x0", "pulse_center"],
        "allowedUnits": ["m"],
        "min": -10,
        "max": 10
      },
      {
        "key": "boundary_position",
        "aliases": ["boundary", "x_boundary"],
        "allowedUnits": ["m"],
        "positive": true,
        "min": 0.1,
        "max": 10
      }
    ],
    "optionalQuantities": [
      {
        "key": "domain_start",
        "aliases": ["x_min"],
        "allowedUnits": ["m"],
        "defaultValue": 0,
        "defaultUnit": "m",
        "min": -10,
        "max": 0
      },
      {
        "key": "probe_position",
        "aliases": ["x_probe"],
        "allowedUnits": ["m"],
        "defaultValue": 0,
        "defaultUnit": "m",
        "min": -10,
        "max": 10
      },
      {
        "key": "spatial_samples",
        "aliases": ["x_samples"],
        "allowedUnits": ["1"],
        "positive": true,
        "defaultValue": 801,
        "defaultUnit": "1",
        "integer": true,
        "min": 2,
        "max": 4096
      },
      {
        "key": "reflection_coefficient",
        "aliases": ["reflectivity", "reflection_factor"],
        "allowedUnits": ["1"],
        "defaultValue": -1,
        "defaultUnit": "1",
        "min": -1,
        "max": 1
      }
    ],
    "adjustableParameters": [
      {"key": "amplitude", "label": "Pulse amplitude", "symbol": "A", "unit": "m", "min": 0, "max": 1, "step": 0.001},
      {"key": "wave_speed", "label": "Wave speed", "symbol": "c", "unit": "m/s", "min": 0.1, "max": 20, "step": 0.1},
      {"key": "pulse_width", "label": "Pulse width", "symbol": "w", "unit": "m", "min": 0.1, "max": 5, "step": 0.01},
      {"key": "boundary_position", "label": "Boundary position", "symbol": "L", "unit": "m", "min": 0.1, "max": 10, "step": 0.1},
      {"key": "reflection_coefficient", "label": "Reflection coefficient", "symbol": "r", "unit": "1", "min": -1, "max": 1, "step": 0.01}
    ],
    "visualization": {
      "scene": "wave_reflection",
      "series": [
        {"key": "displacement", "source": "values.displacement", "label": "Displacement at probe", "symbol": "u", "unit": "m", "color": "#38bdf8"},
        {"key": "particleVelocity", "source": "values.particleVelocity", "label": "Particle velocity", "symbol": "u_dot", "unit": "m/s", "color": "#34d399"},
        {"key": "particleAcceleration", "source": "values.particleAcceleration", "label": "Particle acceleration", "symbol": "u_ddot", "unit": "m/s2", "color": "#fb923c"}
      ],
      "presentation": {
        "theme": "lab-night",
        "environment": "track.engineering",
        "wave": {"fieldId": "reflectionDisplacement", "probeX": {"source": "quantity", "key": "probe_position"}, "displayExaggeration": 1},
        "sceneGraph": {
          "nodes": [
            {"id": "background", "type": "background", "layer": "static"},
            {"id": "grid", "type": "grid", "layer": "static"},
            {"id": "environment", "type": "environment", "layer": "static", "properties": {"environment": "track.engineering", "layout": "horizontalTrack"}},
            {"id": "wave", "type": "waveField", "layer": "dynamic", "properties": {"field": "reflectionDisplacement", "probeX": {"source": "quantity", "key": "probe_position"}, "displayExaggeration": 1}},
            {"id": "boundary", "type": "ruler", "layer": "static"}
          ]
        }
      }
    },
    "execution": {"durationSeconds": 1, "stepSeconds": 0.001, "durationBindings": []},
    "validation": {"tolerance": 0.000001, "checkpointFractions": [0.25, 0.5, 0.75, 1]},
    "output": {"type": "scalarField", "fieldId": "reflectionDisplacement", "probeSeries": ["displacement", "particleVelocity", "particleAcceleration"]}
  }
}
