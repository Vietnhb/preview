{
  "schemaId": "radio_signal_chain",
  "model": "radio_signal_chain",
  "name": "AM FM modulation and signal attenuation",
  "topic": "WAVES",
  "version": "1.1",
  "solverId": "radio_signal_chain_solver_v2",
  "referenceSolverId": "radio_signal_chain_reference_v2",
  "definition": {
    "requiredQuantities": [
      {
        "key": "carrier_frequency",
        "aliases": [
          "fc"
        ],
        "allowedUnits": [
          "Hz"
        ],
        "positive": true
      },
      {
        "key": "modulation_frequency",
        "aliases": [
          "fm"
        ],
        "allowedUnits": [
          "Hz"
        ],
        "positive": true
      },
      {
        "key": "frequency_deviation",
        "aliases": [
          "delta_f"
        ],
        "allowedUnits": [
          "Hz"
        ],
        "nonNegative": true
      },
      {
        "key": "modulation_index",
        "aliases": [
          "m"
        ],
        "allowedUnits": [
          "1"
        ],
        "nonNegative": true
      },
      {
        "key": "signal_amplitude",
        "aliases": [
          "A"
        ],
        "allowedUnits": [
          "V"
        ],
        "nonNegative": true
      },
      {
        "key": "path_length",
        "aliases": [
          "d"
        ],
        "allowedUnits": [
          "m"
        ],
        "nonNegative": true
      },
      {
        "key": "attenuation_db_per_meter",
        "aliases": [
          "alpha_db"
        ],
        "allowedUnits": [
          "dB/m"
        ],
        "nonNegative": true
      }
    ],
    "adjustableParameters": [
      {
        "key": "path_length",
        "label": "Transmission path length",
        "symbol": "d",
        "unit": "m",
        "min": 0,
        "max": 100000,
        "step": 1
      }
    ],
    "visualization": {
      "scene": "radio_signal_chain",
      "series": [
        {
          "key": "receivedAmplitude",
          "source": "values.receivedAmplitude",
          "label": "Received amplitude",
          "symbol": "A_r",
          "unit": "V",
          "color": "#38bdf8"
        },
        {
          "key": "fmModulationIndex",
          "source": "values.fmModulationIndex",
          "label": "FM modulation index",
          "symbol": "beta",
          "unit": "1",
          "color": "#fb923c"
        },
        {
          "key": "carsonBandwidth",
          "source": "values.carsonBandwidth",
          "label": "Carson bandwidth",
          "symbol": "B_T",
          "unit": "Hz",
          "color": "#34d399"
        }
      ]
    },
    "execution": {
      "durationSeconds": 1,
      "stepSeconds": 0.1,
      "durationBindings": []
    },
    "validation": {
      "tolerance": 1e-06,
      "checkpointFractions": [
        0.25,
        0.5,
        0.75,
        1
      ]
    },
    "output": {
      "type": "timeseries",
      "probeSeries": [
        "wavelength",
        "lowerSideband",
        "upperSideband",
        "fmModulationIndex",
        "carsonBandwidth",
        "attenuationFactor",
        "receivedAmplitude"
      ],
      "definitions": [
        {
          "key": "wavelength",
          "kind": "time_series",
          "unit": "m",
          "required": true
        },
        {
          "key": "lowerSideband",
          "kind": "time_series",
          "unit": "Hz",
          "required": true
        },
        {
          "key": "upperSideband",
          "kind": "time_series",
          "unit": "Hz",
          "required": true
        },
        {
          "key": "fmModulationIndex",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "carsonBandwidth",
          "kind": "time_series",
          "unit": "Hz",
          "required": true
        },
        {
          "key": "attenuationFactor",
          "kind": "time_series",
          "unit": "1",
          "required": true
        },
        {
          "key": "receivedAmplitude",
          "kind": "time_series",
          "unit": "V",
          "required": true
        }
      ]
    }
  }
}
