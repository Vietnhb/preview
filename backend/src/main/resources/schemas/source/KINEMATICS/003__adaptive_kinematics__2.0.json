    "laws": [
      {
        "id": "velocity_definition",
        "name": "Định nghĩa vận tốc",
        "inputs": [
          "velocity"
        ],
        "outputs": [
          "position"
        ],
        "appliesTo": {
          "objectTypes": [
            "moving_body"
          ],
          "quantities": [
            "velocity",
            "position"
          ]
        },
        "assumptions": [
          "Frame and positive axis known when direction matters."
        ],
        "description": "Velocity is the rate of position change."
      },
      {
        "id": "acceleration_definition",
        "name": "Định nghĩa gia tốc",
        "inputs": [
          "acceleration"
        ],
        "outputs": [
          "velocity"
        ],
        "appliesTo": {
          "objectTypes": [
            "moving_body"
          ],
          "quantities": [
            "acceleration",
            "velocity"
          ]
        },
        "assumptions": [
          "Velocity and acceleration share an axis."
        ],
        "description": "Acceleration is the rate of velocity change."
      },
      {
        "id": "constant_acceleration",
        "name": "Gia tốc không đổi",
        "inputs": [
          "initial_position",
          "initial_velocity",
          "acceleration",
