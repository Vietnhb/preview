            "mul",
            "efficiency",
            "input_power"
          ],
          "elapsed_time"
        ],
        "input_energy": [
          "mul",
          "input_power",
          "elapsed_time"
        ],
        "useful_power": [
          "mul",
          "efficiency",
          "input_power"
        ]
      },
      "closedForm": {
        "elapsed_time": "t",
        "position": [
          "add",
