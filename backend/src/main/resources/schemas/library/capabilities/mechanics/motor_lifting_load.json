        ],
        "input_energy": [
          "mul",
          "input_power",
          "t"
        ],
        "useful_power": [
          "mul",
          "efficiency",
          "input_power"
        ]
      }
    }
  },
  "validation": {
    "absoluteTolerance": 0.0001,
    "relativeTolerance": 0.0001,
