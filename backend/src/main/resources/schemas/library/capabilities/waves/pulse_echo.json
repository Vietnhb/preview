        "elapsed_time": 0
      },
      "rates": {
        "elapsed_time": 1
      },
      "outputs": {
        "elapsed_time": "elapsed_time",
        "position": [
          "sub",
          "reflector_distance",
          [
            "abs",
            [
              "sub",
              "reflector_distance",
              [
                "mul",
                "wave_speed",
                [
                  "mul",
                  0.5,
                  [
                    "sub",
                    [
                      "add",
                      "elapsed_time",
                      [
                        "div",
                        [
                          "mul",
                          2,
                          "reflector_distance"
                        ],
                        "wave_speed"
                      ]
                    ],
                    [
                      "abs",
                      [
                        "sub",
                        "elapsed_time",
                        [
                          "div",
                          [
                            "mul",
                            2,
                            "reflector_distance"
                          ],
                          "wave_speed"
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        "echo_delay": [
          "div",
          [
            "mul",
            2,
            "reflector_distance"
          ],
          "wave_speed"
        ]
      },
      "closedForm": {
        "elapsed_time": "t",
        "position": [
          "sub",
          "reflector_distance",
          [
            "abs",
            [
              "sub",
              "reflector_distance",
              [
                "mul",
                "wave_speed",
                [
                  "mul",
                  0.5,
                  [
                    "sub",
                    [
                      "add",
                      "t",
                      [
                        "div",
                        [
                          "mul",
                          2,
                          "reflector_distance"
                        ],
                        "wave_speed"
                      ]
                    ],
                    [
                      "abs",
                      [
                        "sub",
                        "t",
                        [
                          "div",
                          [
                            "mul",
                            2,
                            "reflector_distance"
                          ],
                          "wave_speed"
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        "echo_delay": [
          "div",
          [
            "mul",
            2,
            "reflector_distance"
          ],
          "wave_speed"
        ]
      }
    }
  },
  "validation": {
    "absoluteTolerance": 0.0001,
