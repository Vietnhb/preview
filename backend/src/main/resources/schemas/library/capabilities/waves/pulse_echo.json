      "key": "elapsed_time",
      "unit": "s"
    },
    {
      "key": "position",
      "unit": "m"
    },
    {
      "key": "echo_delay",
      "unit": "s"
    }
  ],
  "assumptions": [
    "Xung truyền thẳng tới mặt phản xạ rồi quay về nguồn với cùng tốc độ; vị trí là khoảng cách của xung tới nguồn."
  ],
  "equationSet": {
    "canonical": [
      "t_vong = 2*d/v"
    ],
    "derived": [
      "d = v*t/2"
    ]
  },
  "execution": {
    "primary": "analytical",
    "numerical": {
      "solverId": "schema_ast_rk4",
      "method": "rk4"
    },
    "closedForm": {
      "solverId": "schema_ast_reference",
      "method": "approved_ast"
    },
    "math": {
