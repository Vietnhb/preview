{
  "capabilityId": "pulse_echo",
  "title": "Xung phản xạ – tiếng vang, siêu âm, sonar",
  "version": "1.0",
  "applicability": {
    "objectTypes": [
      "wave_source",
      "medium",
      "receiver"
    ],
    "quantities": [
      "wave_speed",
      "reflector_distance"
    ]
  },
  "canonicalInputs": [
    {
      "key": "wave_speed",
      "unit": "m/s",
      "min": 1e-09
    },
    {
      "key": "reflector_distance",
      "unit": "m",
      "min": 1e-09
    }
  ],
  "outputs": [
