  "assumptions": [
    "Đoạn dây thẳng mang dòng điện không đổi đặt trong từ trường đều, được xoay dần để đổi góc theta giữa dây và B (cân dòng điện)."
  ],
  "equationSet": {
    "canonical": [
      "F = B*I*l*sin(theta)"
    ],
    "derived": [
      "B = F/(I*l) khi dây vuông góc"
    ]
  },
  "execution": {
