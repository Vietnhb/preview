{
  "capabilityId": "force_on_wire_rotating_angle",
  "title": "Lực từ lên dây dẫn theo góc với cảm ứng từ",
  "version": "1.0",
  "applicability": {
    "objectTypes": [
      "conductor",
      "field_region"
    ],
    "quantities": [
      "flux_density",
      "current",
      "wire_length",
      "angular_velocity",
      "initial_angle"
    ]
  },
  "canonicalInputs": [
    {
      "key": "flux_density",
