  ],
  "equationSet": {
    "canonical": [
      "u = U0*cos(omega*t)",
      "i = I0*cos(omega*t - phi)",
      "Z = sqrt(R^2 + (ZL - ZC)^2)"
    ],
    "derived": [
      "ZL = omega*L",
      "ZC = 1/(omega*C)",
      "I0 = U0/Z",
      "cos(phi) = R/Z",
      "P = U*I*cos(phi)",
      "U = U0/sqrt(2)",
      "P_tb = U*I*cos(phi)"
    ]
  },
