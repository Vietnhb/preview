  "assumptions": [
    "Nhiệt độ tăng đều; hai mô hình đặt cạnh nhau để so sánh (B = 0 khi không xét điện trở nhiệt)."
  ],
  "equationSet": {
    "canonical": [
      "R = R0*(1 + alpha*(T - T0)) (kim loại)",
      "R = R0*exp(B*(1/T - 1/T0)) (điện trở nhiệt NTC, bán dẫn)"
    ],
    "derived": [
      "I = U/R"
    ]
  },
