{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["READY", "UNSUPPORTED"] },
    "reason": { "type": ["string", "null"] },
    "scene": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "units": { "type": "string", "enum": ["SI"] },
        "durationSeconds": { "type": "number" },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minX": { "type": "number" },
            "maxX": { "type": "number" },
            "minY": { "type": "number" },
            "maxY": { "type": "number" }
          },
          "required": ["minX", "maxX", "minY", "maxY"]
        },
        "gravity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "required": ["x", "y"]
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "sourceObjectIndex": { "type": "integer" },
              "shape": { "type": "string", "enum": ["circle", "rectangle"] },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "radius": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" },
              "mass": { "type": "number" },
              "vx": { "type": "number" },
              "vy": { "type": "number" },
              "isStatic": { "type": "boolean" },
              "restitution": { "type": "number" },
              "friction": { "type": "number" },
              "frictionAir": { "type": "number" }
            },
            "required": ["id", "label", "sourceObjectIndex", "shape", "x", "y", "radius", "width", "height", "mass", "vx", "vy", "isStatic", "restitution", "friction", "frictionAir"]
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceConstraintIndex": { "type": "integer" },
              "bodyA": { "type": ["string", "null"] },
              "bodyB": { "type": ["string", "null"] },
              "anchorAx": { "type": "number" },
              "anchorAy": { "type": "number" },
              "anchorBx": { "type": "number" },
              "anchorBy": { "type": "number" },
              "length": { "type": "number" },
              "stiffness": { "type": "number" },
              "damping": { "type": "number" }
            },
            "required": ["sourceConstraintIndex", "bodyA", "bodyB", "anchorAx", "anchorAy", "anchorBx", "anchorBy", "length", "stiffness", "damping"]
          }
        },
        "expectedContacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bodyA": { "type": "string" },
              "bodyB": { "type": "string" }
            },
            "required": ["bodyA", "bodyB"]
          }
        }
      },
      "required": ["units", "durationSeconds", "view", "gravity", "bodies", "constraints", "expectedContacts"]
    }
  },
  "required": ["status", "reason", "scene"]
}
