{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "CLARIFY",
        "EXPLAIN",
        "UNSUPPORTED"
      ]
    },
    "question": {
      "type": [
        "string",
        "null"
      ]
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "defaults": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "simulationSpec": {
      "type": ["object", "null"],
      "description": "Open semantic brief. Keep the known fields when useful and add domain-specific fields when the scene needs them.",
      "additionalProperties": true,
      "properties": {
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "durationParameter": { "type": "string", "description": "Optional name of a seconds-valued duration control; initial value equals durationSeconds." },
        "physicsCoverage": { "enum": ["COMPLETE", "PARTIAL", "NONE"] },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }, "label": { "type": "string" },
              "value": { "type": "number" }, "unit": { "type": "string" },
              "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" }
            },
            "required": ["name", "label", "value", "unit", "min", "max"]
          }
        },
        "physicsModels": {
          "type": "array",
          "description": "Bindings to approved capability equations. Every model has a unique id, capabilityId and inputs mapping canonical input keys to parameter names or SI numeric constants. Do not put executable formulas here.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" }, "label": { "type": "string" }, "capabilityId": { "type": "string" },
              "inputs": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
            },
            "required": ["id", "capabilityId", "inputs"]
          }
        },
        "runtimeKind": {
          "type": ["string", "null"],
          "description": "Optional transport marker. The server normalizes this to VISUAL and it never restricts the subject, style, or rendering technique."
        },
        "externalForces": { "type": ["boolean", "null"] },
        "friction": { "type": ["boolean", "null"] },
        "conservativeInteractions": { "type": ["boolean", "null"] },
        "physicalObjects": {
          "type": "array",
          "items": {}
        },
        "interactions": {
          "type": "array",
          "items": {}
        },
        "initialState": { "type": ["string", "array", "object", "null"] },
        "visualIntent": { "type": ["string", "array", "object", "null"] },
        "visualHints": {
          "type": "array",
          "items": {}
        },
        "visualEffects": {
          "type": "array",
          "items": {}
        },
        "displayPlan": { "type": ["string", "array", "object", "null"] },
        "schemaId": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"] },
        "topicVersion": { "type": ["string", "null"] },
        "capabilityId": { "type": ["string", "null"] },
        "solverBinding": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "capabilityId": { "type": ["string", "null"] },
            "durationSeconds": { "type": ["number", "null"] },
            "stepSeconds": { "type": ["number", "null"] },
            "participants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "id": { "type": ["string", "null"] },
                  "label": { "type": ["string", "null"] },
                  "quantities": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        },
        "requiredObjects": {
          "type": "array",
          "description": "Explicitly named or counted participants. Contextual scenery may be represented elsewhere and does not need an artificial inventory entry.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "sourceQuote": { "type": ["string", "null"] },
              "label": { "type": ["string", "null"] },
              "count": { "type": ["integer", "null"] },
              "shape": { "type": ["string", "null"] },
              "role": { "type": ["string", "null"] },
              "contextual": { "type": ["boolean", "null"] },
              "visualDescription": { "type": ["string", "null"] }
            }
          }
        },
        "requiredConstraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "sourceQuote": { "type": ["string", "null"] },
              "label": { "type": ["string", "null"] },
              "count": { "type": ["integer", "null"] },
              "kind": { "type": ["string", "null"] },
              "details": {}
            }
          }
        },
        "spatialRelations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "sourceQuote": { "type": ["string", "null"] },
              "subjectObjectIndex": { "type": ["integer", "null"] },
              "referenceObjectIndex": { "type": ["integer", "null"] },
              "axis": { "type": ["string", "null"] },
              "ordering": { "type": ["string", "null"] },
              "relation": { "type": ["string", "null"] },
              "subject": { "type": ["string", "null"] },
              "reference": { "type": ["string", "null"] }
            }
          }
        },
        "fixedQuantities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "sourceQuote": { "type": ["string", "null"] },
              "name": { "type": ["string", "null"] },
              "valueSI": { "type": ["number", "array", "object", "string", "null"] },
              "unitSI": { "type": ["string", "null"] },
              "provenance": { "type": ["string", "null"] },
              "valueStructure": { "type": ["string", "null"] },
              "sceneField": { "type": ["string", "null"] },
              "bodyRequirementIndexes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "constraintRequirementIndexes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "referenceObjectIndexes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "required": []
    }
  },
  "required": [
    "status",
    "question",
    "explanation",
    "defaults",
    "simulationSpec"
  ]
}
