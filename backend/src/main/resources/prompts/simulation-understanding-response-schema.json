{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "status": { "type": "string", "enum": ["CLARIFY", "EXPLAIN", "UNSUPPORTED"] },
    "question": { "type": ["string", "null"] },
    "choices": {
      "type": "array",
      "description": "CLARIFY only: the concrete options the question offers, each a short complete phrase. Empty otherwise.",
      "items": { "type": "string" }
    },
    "explanation": { "type": ["string", "null"] },
    "defaults": { "type": "array", "items": { "type": "string" } },
    "simulationSpec": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "durationParameter": { "type": "string", "description": "Optional name of a seconds-valued duration control; initial value equals durationSeconds." },
        "physicsCoverage": { "enum": ["COMPLETE", "PARTIAL", "NONE"] },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }, "label": { "type": "string" },
              "value": { "type": "number" }, "unit": { "type": "string" },
              "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" }
            },
            "required": ["name", "label", "value", "unit", "min", "max"]
          }
        },
        "physicsModels": {
          "type": "array",
          "description": "Bindings to approved capability equations. Every model has a unique id, capabilityId and inputs mapping canonical input keys to parameter names or SI numeric constants. Do not put executable formulas here.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" }, "label": { "type": "string" }, "capabilityId": { "type": "string" },
              "inputs": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
            },
            "required": ["id", "capabilityId", "inputs"]
          }
        },
        "sharedQuantities": {
          "type": "array",
          "description": "Names of the parameters that more than one participant uses.",
          "items": { "type": "string" }
        },
        "requiredObjects": {
          "type": "array",
          "description": "Every object the user names or counts.",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "count": { "type": "integer" },
              "shape": { "type": ["string", "null"] },
              "contextual": { "type": "boolean" }
            },
            "required": ["label", "count"]
          }
        },
        "observables": {
          "type": "array",
          "description": "The computed results the learner watches, most important first.",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string", "description": "A participant id, a dot and one of its output keys." },
              "object": { "type": "string", "description": "The object it belongs to, named as in requiredObjects." },
              "label": { "type": "string", "description": "Its name in the user's words." }
            },
            "required": ["field", "object", "label"]
          }
        }
      },
      "required": []
    }
  },
  "required": ["status", "question", "explanation", "defaults", "simulationSpec"]
}
