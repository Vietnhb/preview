{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visualProgram"
  ],
  "properties": {
    "visualProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "description",
        "scene"
      ],
      "properties": {
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept",
            "objects",
            "layout",
            "animation",
            "palette"
          ],
          "properties": {
            "concept": {
              "type": "string",
              "description": "What the learner should notice and the representation chosen for it."
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "object",
                  "representation"
                ],
                "properties": {
                  "object": {
                    "type": "string",
                    "description": "An object of confirmedBrief.objects."
                  },
                  "representation": {
                    "type": "string",
                    "description": "How it looks and which body, part or note shows its values."
                  }
                }
              }
            },
            "layout": {
              "type": "string",
              "description": "Composition and framing."
            },
            "animation": {
              "type": "string",
              "description": "Which field moves what."
            },
            "palette": {
              "type": "string",
              "description": "Colours readable on light and dark backgrounds."
            }
          }
        },
        "description": {
          "type": "string",
          "description": "One or two sentences in the user's language describing the scene."
        },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "environmentAnchorY",
            "surface",
            "support",
            "connector",
            "bodies",
            "drawings",
            "links",
            "fixtures",
            "overlay"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "description": "Full-stage backdrop Complete SVG document (~16:9, static); '' if none."
            },
            "environmentAnchorY": {
              "type": "number",
              "description": "viewBox y of the backdrop line that sits on the physical reference line: the ground (height 0) or the support bodies hang from; -1 if none."
            },
            "surface": {
              "type": "string",
              "description": "Horizontally tileable SVG strip bodies move or rest on, top edge = contact line; '' if none."
            },
            "support": {
              "type": "string",
              "description": "SVG of the fixed support a connector hangs from, bottom-centre = attachment point; '' if unused."
            },
            "connector": {
              "type": "string",
              "description": "SVG of a string, rod or spring drawn along +x, stretched by the kit; viewBox height = thickness in px (1.5-30); '' if unused."
            },
            "bodies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "svg",
                  "facing",
                  "rotate",
                  "anchor",
                  "sizeMeters",
                  "line",
                  "solid"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Participant id."
                  },
                  "svg": {
                    "type": "string",
                    "description": "Complete SVG document of the body only (no connector, support, label or vector), facing +x, tightly framed."
                  },
                  "facing": {
                    "type": "string",
                    "enum": [
                      "right",
                      "left",
                      "none"
                    ],
                    "description": "The kit mirrors the drawing when the body moves the other way; none = symmetric."
                  },
                  "rotate": {
                    "type": "string",
                    "enum": [
                      "none",
                      "velocity",
                      "link"
                    ],
                    "description": "velocity: nose follows the motion; link: hangs along its connector; none: upright."
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "bottom",
                      "center"
                    ],
                    "description": "bottom: rests on its surface; center: the solver point is its centre; auto: kit default."
                  },
                  "sizeMeters": {
                    "type": "number",
                    "description": "Real size of its largest dimension in metres (0 = readable default)."
                  },
                  "line": {
                    "type": "string",
                    "description": "Name of the line it moves on; bodies with the same name share it. '' = decided from the motion."
                  },
                  "solid": {
                    "type": "boolean",
                    "description": "Rigid: nothing solid on its line may pass through it."
                  }
                }
              },
              "description": "One per participant that moves in space."
            },
            "drawings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "svg",
                  "size",
                  "parts",
                  "notes"
                ],
                "properties": {
                  "svg": {
                    "type": "string",
                    "description": "Complete SVG document of the static drawing: the set-up with its objects in their real arrangement."
                  },
                  "size": {
                    "type": "number",
                    "description": "Its share of the stage relative to the other drawings (1 = default); give the main set-up the largest. The frame of moving bodies takes at least as much as all drawings together."
                  },
                  "parts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "svg",
                        "channels",
                        "pivot",
                        "path",
                        "copies",
                        "label",
                        "labelAnchor",
                        "inline",
                        "color"
                      ],
                      "properties": {
                        "svg": {
                          "type": "string",
                          "description": "Complete SVG document of the moving part only, in its drawing's viewBox, drawn once at its starting place."
                        },
                        "channels": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "field",
                              "property",
                              "from",
                              "to",
                              "min",
                              "max",
                              "marks"
                            ],
                            "properties": {
                              "field": {
                                "type": "string",
                                "description": "Exact solver key from solverFields."
                              },
                              "property": {
                                "type": "string",
                                "enum": [
                                  "rotate",
                                  "angle",
                                  "x",
                                  "y",
                                  "along",
                                  "reveal",
                                  "scale",
                                  "scaleX",
                                  "scaleY",
                                  "opacity",
                                  "travel"
                                ],
                                "description": "How the value changes the part (the part turns and stretches about its pivot, then shifts): rotate = turns, from/to = degrees clockwise; angle = turns by the value's own angle; x, y = shift from its drawn place by from/to drawing units (y down); along = moves to fraction from/to of its path; reveal = shown from the path start up to fraction from/to (a level, a bar, a growing length); scale, scaleX, scaleY = stretch factor from/to; opacity = alpha from/to; travel = its copies flow along the path at a speed proportional to the value, completing 'to' laps over the run at max (about 1 reads calmly); they keep their drawn orientation, re-enter an open path at its start, and combine only with opacity. For angle (counter-clockwise for a positive value) from, to, min and max are not used."
                              },
                              "from": {
                                "type": "number"
                              },
                              "to": {
                                "type": "number"
                              },
                              "min": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "description": "Value that gives 'from'; values beyond stay at from. null = a range fitted to the current run (refitted when a slider changes; fix min and max to compare runs), shared by the null-range values of one unit on one drawing so they compare."
                              },
                              "max": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "description": "Value that gives 'to'; values beyond stay at to (null = as for min)."
                              },
                              "marks": {
                                "type": "boolean",
                                "description": "Print the value scale along the sweep (a dial, a gauge, a ruler, a plot axis)."
                              }
                            }
                          },
                          "description": "The values that move it; several combine (a point plotted by two values, an arrow that turns and grows). Its label shows every value they follow."
                        },
                        "pivot": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          },
                          "description": "Point it turns or stretches about (drawing's viewBox); x and y value scales are printed along lines through it."
                        },
                        "path": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "x",
                              "y"
                            ],
                            "properties": {
                              "x": {
                                "type": "number"
                              },
                              "y": {
                                "type": "number"
                              }
                            }
                          },
                          "description": "At least 2 points for along, reveal and travel; [] otherwise."
                        },
                        "copies": {
                          "type": "number",
                          "description": "travel: 1-60 copies; 1 otherwise."
                        },
                        "label": {
                          "type": "string",
                          "description": "Name on its label in the user's language ('' = the value's name)."
                        },
                        "labelAnchor": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "x",
                                "y"
                              ],
                              "properties": {
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Point on its object where its live value is shown (labels stay where they are put; they do not follow the part); null = no label."
                        },
                        "inline": {
                          "type": "boolean",
                          "description": "Label as text centred on labelAnchor instead of a card beside it (a card when the text has no room)."
                        },
                        "color": {
                          "type": "string",
                          "description": "Accent colour of its label, e.g. the colour of the part ('' = default)."
                        }
                      }
                    },
                    "description": "The parts that show changing values where they happen."
                  },
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "field",
                        "at",
                        "inline",
                        "color"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "Name in the user's language: a name, never a value ('' with a field = the value's name)."
                        },
                        "field": {
                          "type": "string",
                          "description": "Exact solver key, plan parameter name or fixed-value name (confirmedBrief.constants) whose current value is shown; '' for a name only."
                        },
                        "at": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          }
                        },
                        "inline": {
                          "type": "boolean",
                          "description": "Text centred on the point instead of a card beside it (a card when the text has no room)."
                        },
                        "color": {
                          "type": "string",
                          "description": "Accent colour ('' = default)."
                        }
                      }
                    },
                    "description": "Names, live values and slider values at points of the drawing."
                  }
                }
              },
              "description": "Set-up drawings; everything that changes without moving in space is shown on them."
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "color",
                  "width",
                  "dashed"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "A moving participant id, a fixed point 'x,y' in metres, or '<participant id>:x,y' in that participant's own frame."
                  },
                  "to": {
                    "type": "string",
                    "description": "A moving participant id, a fixed point 'x,y' in metres, or '<participant id>:x,y' in that participant's own frame."
                  },
                  "color": {
                    "type": "string",
                    "description": "CSS colour ('' = default)."
                  },
                  "width": {
                    "type": "number",
                    "description": "1-12 px."
                  },
                  "dashed": {
                    "type": "boolean"
                  }
                }
              },
              "description": "Connections whose ends move, redrawn every frame."
            },
            "fixtures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "svg",
                  "x",
                  "xParameter",
                  "y",
                  "yParameter",
                  "anchor",
                  "sizeMeters",
                  "solid",
                  "angle",
                  "angleParameter",
                  "angleScale",
                  "flipBy",
                  "frame"
                ],
                "properties": {
                  "svg": {
                    "type": "string",
                    "description": "Complete SVG document of the fixture only."
                  },
                  "x": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Position in metres (null when xParameter is used or it does not matter)."
                  },
                  "xParameter": {
                    "type": "string",
                    "description": "Plan parameter holding the position; '' if x is used."
                  },
                  "y": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Height in metres, or null."
                  },
                  "yParameter": {
                    "type": "string",
                    "description": "Plan parameter holding the height; '' if unused."
                  },
                  "anchor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "description": "Point of the SVG (viewBox units) that sits at the position."
                  },
                  "sizeMeters": {
                    "type": "number",
                    "description": "Real size of its largest dimension in metres (0 = readable default)."
                  },
                  "solid": {
                    "type": "boolean",
                    "description": "Moving bodies must not pass through it."
                  },
                  "angle": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Rotation in screen degrees clockwise (null = as drawn)."
                  },
                  "angleParameter": {
                    "type": "string",
                    "description": "Plan parameter giving the rotation instead; '' if unused."
                  },
                  "angleScale": {
                    "type": "number",
                    "description": "Factor from angle or parameter to screen degrees clockwise (1 for degrees, -57.2958 for counter-clockwise radians)."
                  },
                  "flipBy": {
                    "type": "string",
                    "description": "Plan parameter whose negative value mirrors the drawing; '' if unused."
                  },
                  "frame": {
                    "type": "string",
                    "description": "Participant id whose own frame x, y are measured in (independent systems side by side); '' = common frame."
                  }
                }
              },
              "description": "Things that stand still at a physical place."
            },
            "overlay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "links",
                "axes",
                "trails",
                "vectors",
                "labels",
                "angles"
              ],
              "properties": {
                "links": {
                  "type": "boolean",
                  "description": "Plain line for a connector (not drawn when connector artwork is given)."
                },
                "axes": {
                  "type": "boolean",
                  "description": "Measured axes with SI units."
                },
                "trails": {
                  "type": "boolean",
                  "description": "Path already travelled."
                },
                "vectors": {
                  "type": "boolean",
                  "description": "Velocity, acceleration and force arrows with their values."
                },
                "labels": {
                  "type": "boolean",
                  "description": "Participant names."
                },
                "angles": {
                  "type": "boolean",
                  "description": "Angle marks with their live value for bodies on connectors."
                }
              }
            }
          }
        }
      }
    }
  }
}
