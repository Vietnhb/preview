{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visualProgram"
  ],
  "properties": {
    "visualProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "description",
        "scene",
        "code"
      ],
      "properties": {
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept",
            "objects",
            "layout",
            "animation",
            "palette"
          ],
          "properties": {
            "concept": {
              "type": "string",
              "description": "What the learner should notice and the representation chosen for it."
            },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "object",
                  "representation"
                ],
                "properties": {
                  "object": {
                    "type": "string",
                    "description": "An object of confirmedBrief.objects."
                  },
                  "representation": {
                    "type": "string",
                    "description": "How it looks and which body, part or annotation shows its values."
                  }
                }
              }
            },
            "layout": {
              "type": "string",
              "description": "Composition and framing."
            },
            "animation": {
              "type": "string",
              "description": "Which field moves what."
            },
            "palette": {
              "type": "string",
              "description": "Colours readable on light and dark backgrounds."
            }
          }
        },
        "description": {
          "type": "string",
          "description": "One or two sentences in the user's language describing the scene."
        },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "environmentAnchorY",
            "surface",
            "support",
            "connector",
            "bodies",
            "instruments",
            "links",
            "fixtures",
            "overlay",
            "annotations"
          ],
          "properties": {
            "environment": {
              "type": "string",
              "description": "Full-stage backdrop Complete SVG document (~16:9, static); '' if none."
            },
            "environmentAnchorY": {
              "type": "number",
              "description": "viewBox y of the backdrop line that must sit on the physical reference line (support line or ground); -1 if none."
            },
            "surface": {
              "type": "string",
              "description": "Horizontally tileable SVG strip bodies move or rest on, top edge = contact line; '' if none."
            },
            "support": {
              "type": "string",
              "description": "SVG of the fixed support a connector hangs from, bottom-centre = attachment point; '' if unused."
            },
            "connector": {
              "type": "string",
              "description": "SVG of a string, rod or spring drawn along +x, stretched by the kit; viewBox height = thickness in px (1.5-30); '' if unused."
            },
            "bodies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "svg",
                  "facing",
                  "rotate",
                  "anchor",
                  "sizeMeters",
                  "line",
                  "solid"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Participant id."
                  },
                  "svg": {
                    "type": "string",
                    "description": "Complete SVG document of the body only (no connector, support, label or vector), facing +x, tightly framed."
                  },
                  "facing": {
                    "type": "string",
                    "enum": [
                      "right",
                      "left",
                      "none"
                    ],
                    "description": "The kit mirrors the drawing when the body moves the other way; none = symmetric."
                  },
                  "rotate": {
                    "type": "string",
                    "enum": [
                      "none",
                      "velocity",
                      "link"
                    ],
                    "description": "velocity: nose follows the motion; link: hangs along its connector; none: upright."
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "bottom",
                      "center"
                    ],
                    "description": "bottom: rests on its surface; center: the solver point is its centre; auto: kit default."
                  },
                  "sizeMeters": {
                    "type": "number",
                    "description": "Real size of its largest dimension in metres (0 = readable default)."
                  },
                  "line": {
                    "type": "string",
                    "description": "Name of the line it moves on; bodies with the same name share it. '' = decided from the motion."
                  },
                  "solid": {
                    "type": "boolean",
                    "description": "Rigid: nothing solid on its line may pass through it."
                  }
                }
              },
              "description": "One per participant that moves in space."
            },
            "instruments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "label",
                  "svg",
                  "part",
                  "drive",
                  "on",
                  "labelAnchor",
                  "size",
                  "components"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Exact solver key that drives the part; '' for a drawing of the set-up that shows no value itself."
                  },
                  "label": {
                    "type": "string",
                    "description": "Short caption in the user's language ('' = the value's name)."
                  },
                  "svg": {
                    "type": "string",
                    "description": "Complete SVG document of the static drawing; '' for a part drawn on another drawing."
                  },
                  "part": {
                    "type": "string",
                    "description": "Complete SVG document of the moving part only, in the same viewBox as its drawing; '' when drive.property is none."
                  },
                  "drive": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "property",
                      "pivot",
                      "path",
                      "from",
                      "to",
                      "copies",
                      "useFieldAngle",
                      "min",
                      "max"
                    ],
                    "properties": {
                      "property": {
                        "type": "string",
                        "enum": [
                          "rotate",
                          "translate",
                          "scale",
                          "reveal",
                          "opacity",
                          "travel",
                          "none"
                        ],
                        "description": "rotate: turns about pivot, from/to = degrees clockwise; translate: slides along path, from/to = fractions 0…1 of it; reveal: shown from path[0] towards the last point up to fraction from/to (a level, a bar); scale: factor from/to about pivot; opacity: alpha from/to; travel: 'copies' copies drawn at path[0] move along path at a speed proportional to the field, to = laps over the whole run at the peak value (about 1 reads calmly; repeat the first point to close a loop); none: static picture."
                      },
                      "pivot": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        }
                      },
                      "path": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          }
                        },
                        "description": "At least 2 points for translate, reveal and travel; [] otherwise."
                      },
                      "from": {
                        "type": "number"
                      },
                      "to": {
                        "type": "number"
                      },
                      "copies": {
                        "type": "number",
                        "description": "travel: 1-60 copies; 1 otherwise."
                      },
                      "useFieldAngle": {
                        "type": "boolean",
                        "description": "rotate only: turn by the field's own angle instead of from/to."
                      },
                      "min": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Field value giving 'from' (null = solver minimum)."
                      },
                      "max": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "Field value giving 'to' (null = solver maximum)."
                      }
                    },
                    "description": "How the field moves the part; points in the drawing's viewBox."
                  },
                  "on": {
                    "type": "string",
                    "description": "'' for an instrument with its own svg; otherwise the drawing the part is drawn on: its position in this list ('0' = first) or its field."
                  },
                  "labelAnchor": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Point on the object where the value is shown (drawing's viewBox); null = path midpoint or pivot."
                  },
                  "size": {
                    "type": "number",
                    "description": "Relative share of the stage for a drawing with its own svg (1 = default)."
                  },
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "object",
                        "box"
                      ],
                      "properties": {
                        "object": {
                          "type": "string",
                          "description": "An object name from observables, exactly."
                        },
                        "box": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y",
                            "w",
                            "h"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "w": {
                              "type": "number"
                            },
                            "h": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "description": "On a drawing with its own svg: where each object named in observables is drawn (viewBox units); [] otherwise."
                  }
                }
              },
              "description": "The set-up drawing and the parts on it that show changing values."
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "color",
                  "width",
                  "dashed"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "A moving participant id, a fixed point 'x,y' in metres, or '<participant id>:x,y' in that participant's own frame."
                  },
                  "to": {
                    "type": "string",
                    "description": "A moving participant id, a fixed point 'x,y' in metres, or '<participant id>:x,y' in that participant's own frame."
                  },
                  "color": {
                    "type": "string",
                    "description": "CSS colour ('' = default)."
                  },
                  "width": {
                    "type": "number",
                    "description": "1-12 px."
                  },
                  "dashed": {
                    "type": "boolean"
                  }
                }
              },
              "description": "Connections whose ends move, redrawn every frame."
            },
            "fixtures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "svg",
                  "x",
                  "xParameter",
                  "y",
                  "yParameter",
                  "anchor",
                  "sizeMeters",
                  "solid",
                  "angle",
                  "angleParameter",
                  "angleScale",
                  "flipBy",
                  "frame"
                ],
                "properties": {
                  "svg": {
                    "type": "string",
                    "description": "Complete SVG document of the fixture only."
                  },
                  "x": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Position in metres (null when xParameter is used or it does not matter)."
                  },
                  "xParameter": {
                    "type": "string",
                    "description": "Plan parameter holding the position; '' if x is used."
                  },
                  "y": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Height in metres, or null."
                  },
                  "yParameter": {
                    "type": "string",
                    "description": "Plan parameter holding the height; '' if unused."
                  },
                  "anchor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "description": "Point of the SVG (viewBox units) that sits at the position."
                  },
                  "sizeMeters": {
                    "type": "number",
                    "description": "Real size of its largest dimension in metres (0 = readable default)."
                  },
                  "solid": {
                    "type": "boolean",
                    "description": "Moving bodies must not pass through it."
                  },
                  "angle": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Rotation in screen degrees clockwise (null = as drawn)."
                  },
                  "angleParameter": {
                    "type": "string",
                    "description": "Plan parameter giving the rotation instead; '' if unused."
                  },
                  "angleScale": {
                    "type": "number",
                    "description": "Factor from angle or parameter to screen degrees clockwise (1 for degrees, -57.2958 for counter-clockwise radians)."
                  },
                  "flipBy": {
                    "type": "string",
                    "description": "Plan parameter whose negative value mirrors the drawing; '' if unused."
                  },
                  "frame": {
                    "type": "string",
                    "description": "Participant id whose own frame x, y are measured in (independent systems side by side); '' = common frame."
                  }
                }
              },
              "description": "Things that stand still at a physical place."
            },
            "overlay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "links",
                "axes",
                "trails",
                "vectors",
                "labels",
                "angles"
              ],
              "properties": {
                "links": {
                  "type": "boolean",
                  "description": "Plain line for a connector without artwork."
                },
                "axes": {
                  "type": "boolean",
                  "description": "Measured axes with SI units."
                },
                "trails": {
                  "type": "boolean",
                  "description": "Path already travelled."
                },
                "vectors": {
                  "type": "boolean",
                  "description": "Velocity, acceleration and force arrows."
                },
                "labels": {
                  "type": "boolean",
                  "description": "Participant names."
                },
                "angles": {
                  "type": "boolean",
                  "description": "Angle marks for bodies on connectors."
                }
              }
            },
            "annotations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "on",
                  "label",
                  "field",
                  "anchor"
                ],
                "properties": {
                  "on": {
                    "type": "string",
                    "description": "The drawing: its position in instruments or its field."
                  },
                  "label": {
                    "type": "string",
                    "description": "Short name in the user's language, no numbers."
                  },
                  "field": {
                    "type": "string",
                    "description": "Exact solver key for a live value; '' for a name only."
                  },
                  "anchor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "description": "Names of components (optionally with a live value) at points of a drawing."
            }
          }
        },
        "code": {
          "type": "string",
          "description": "Optional PixiJS v8 program extending the kit scene; '' when the scene is enough."
        }
      }
    }
  }
}
