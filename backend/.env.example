# Copy .env.example to .env.local; deployments inject the same variable names.
# .env.local is ignored by Git. Keep credentials outside version control.
# Text, vision, and visual models/endpoints are independent settings.

# Application and schema lifecycle
SERVER_PORT=8080
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
BOOTSTRAP_CATALOGS_ENABLED=false
SPRINGDOC_ENABLED=false

# PostgreSQL connection and pool
# DATABASE_URL is preferred; DIRECT_URL and SUPABASE_DB_* are alternatives.
DATABASE_URL=postgresql://<username>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://<username>:<password>@<database-host>:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_TRANSACTION_POOLER_PORT=6543
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=15000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
# Lazy relations per SELECT; reduces repeated round trips in curriculum/library trees.
DB_FETCH_BATCH_SIZE=64

# Authentication and browser access
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRATION_MS=86400000
PASSWORD_BCRYPT_STRENGTH=12
ALLOWED_ORIGINS=https://app.example.com

# Image upload limits
MAX_IMAGE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=11MB

# AI text understanding and OCR (chat-completions-compatible endpoint)
AI_API_KEY=<groq-api-key>
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TEXT_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_UNDERSTANDING_TEMPERATURE=0.2
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=30000
AI_OCR_PROMPT_RESOURCE=classpath:prompts/physics-ocr-system.txt

# AI visual generation (openai_compatible, openrouter, gemini_interactions)
# The provider value selects the wire protocol, not the model vendor.
# Other provider names use the chat-completions-compatible transport.
AI_VISUAL_PROVIDER=openai_compatible
AI_VISUAL_API_KEY=
AI_VISUAL_BASE_URL=
AI_VISUAL_MODEL=qwen/qwen3.8-27b:free
AI_VISUAL_TEMPERATURE=0.4
AI_VISUAL_READ_TIMEOUT_MS=240000
AI_VISUAL_STRICT_STRUCTURED_OUTPUT=true
AI_VISUAL_SUPPORTS_RESPONSE_FORMAT=true
AI_VISUAL_MAX_COMPLETION_TOKENS=32000
AI_VISUAL_REASONING_EFFORT=low

# Jev schema classification
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT=60s
JEV_MINIMUM_CONFIDENCE=0.25
JEV_MINIMUM_MARGIN=0.08
JEV_MAXIMUM_QUERY_CHARACTERS=20000
JEV_MAXIMUM_PROMPT_CHARACTERS=80000

# VNPay checkout and reconciliation
VNPAY_TMN_CODE=<merchant-code>
VNPAY_HASH_SECRET=<merchant-secret>
VNPAY_PAYMENT_URL=<provider-payment-url>
VNPAY_RETURN_URL=https://app.example.com/signup/payment-result
VNPAY_QUERY_URL=<provider-query-url>
VNPAY_SERVER_IP=<public-server-ip>
VNPAY_TIME_ZONE=Asia/Ho_Chi_Minh
VNPAY_CONNECT_TIMEOUT_MS=5000
VNPAY_REQUEST_TIMEOUT_MS=10000
VNPAY_RECONCILE_DELAY_MS=300000
LICENSE_WARNING_DAYS=30

# Community discussion limits
# Maximum comment length and discussion page size (positive integers).
COMMUNITY_COMMENT_MAX_CHARACTERS=2000
COMMUNITY_MAX_PAGE_SIZE=50

# Simulation runtime limits
SIMULATION_DEFAULT_STEP_SECONDS=0.02
SIMULATION_MAX_DURATION_SECONDS=3.2e9
SIMULATION_MAX_SAMPLES=16384
SIMULATION_MAX_PARTICIPANTS=256
SIMULATION_MAX_EQUATION_DEPTH=32
SIMULATION_MAX_EQUATION_NODES=512
SIMULATION_MIN_PRESENTATION_SECONDS=0.1
SIMULATION_MAX_PRESENTATION_SECONDS=40
SIMULATION_MAX_VISUAL_CONTROLS=30
SIMULATION_MAX_PROGRAM_PART_CHARACTERS=50000
SIMULATION_MAX_STATE_BYTES=262144
SIMULATION_MAX_DRAW_COMMANDS_PER_FRAME=1000
SIMULATION_MAX_PHASE_OPERATIONS=2000
SIMULATION_MAX_CALL_DEPTH=128
SIMULATION_MAX_ARRAY_ENTRIES=2000
