# Copy to .env.local for local development. In production, inject the same keys
# through the deployment platform. Never commit real credentials.

SERVER_PORT=8080
DATABASE_URL=postgresql://<username>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://<username>:<password>@<database-host>:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_TRANSACTION_POOLER_PORT=6543
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=15000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

JPA_DDL_AUTO=validate
SQL_INIT_MODE=never
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
BOOTSTRAP_CATALOGS_ENABLED=false
SPRINGDOC_ENABLED=false
ALLOWED_ORIGINS=https://app.example.com
MAX_IMAGE_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=11MB

JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRATION_MS=86400000
PASSWORD_BCRYPT_STRENGTH=12

OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=<production-model-id>
OPENROUTER_OCR_MODEL=<vision-model-id>
OPENROUTER_CONNECT_TIMEOUT_MS=5000
OPENROUTER_READ_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_SYSTEM_PROMPT_RESOURCE=classpath:prompts/physics-specification-system.txt
OPENROUTER_OCR_PROMPT_RESOURCE=classpath:prompts/physics-ocr-system.txt
OPENROUTER_APP_URL=https://app.example.com
OPENROUTER_APP_NAME=PhysLive

VNPAY_TMN_CODE=<merchant-code>
VNPAY_HASH_SECRET=<merchant-secret>
VNPAY_PAYMENT_URL=<provider-payment-url>
VNPAY_RETURN_URL=https://app.example.com/signup/payment-result
VNPAY_QUERY_URL=<provider-query-url>
VNPAY_SERVER_IP=<public-server-ip>
VNPAY_TIME_ZONE=Asia/Ho_Chi_Minh
VNPAY_CONNECT_TIMEOUT_MS=5000
VNPAY_REQUEST_TIMEOUT_MS=10000
VNPAY_RECONCILE_DELAY_MS=300000

LICENSE_WARNING_DAYS=30

REDIS_HEALTH_ENABLED=false
