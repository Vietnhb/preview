# Copy this file to .env.local and replace the placeholder values.
# Never commit .env.local or paste its secrets into chat/issues.

# Standard Supabase ORM URLs are supported directly. DATABASE_URL is preferred.
# Replace <password> completely; do not leave [ ] around the real password.
# Percent-encode reserved URI characters in the password when possible.
DATABASE_URL=postgresql://<username>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://<username>:<password>@<pooler-host>:5432/postgres

# These explicit JDBC variables remain supported for deployments that use them.
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
JWT_SECRET=<at-least-32-random-characters>

OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_OCR_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_CONNECT_TIMEOUT_MS=5000
OPENROUTER_READ_TIMEOUT_MS=30000
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_TOKENS=6000
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=PhysLive
